{
  "apps": [
    {
      "name": "mesto-api",
      "script": "npm",
      "args": "start",
      "env": {
        "NODE_ENV": "production"
      }
    }
  ],
  "deploy": {
    "production": {
      "user": "user",
      "host": "51.250.34.72",
      "ref": "origin/main",
      "repo": "git@github.com:fijispawn/nodejs-mesto-project.git",
      "path": "/home/user/apps/mesto-api",
      "ssh_options": ["-i ~/.ssh/mesto-vm", "-o StrictHostKeyChecking=no"],
      "pre-deploy-local": "ssh -i ~/.ssh/mesto-vm user@51.250.34.72 'mkdir -p /home/user/apps/mesto-api/shared' && scp -i ~/.ssh/mesto-vm .env user@51.250.34.72:/home/user/apps/mesto-api/shared/.env",
      "post-deploy": "cd current && npm ci && cp ../shared/.env .env && pm2 reload ecosystem.config.json --env production",
      "env": {
        "NODE_ENV": "production"
      }
    }
  }
}
